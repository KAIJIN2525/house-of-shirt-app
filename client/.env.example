# Supabase project (Project Settings -> API). The anon key is safe to ship in
# the client; the service role key must never appear here or in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

EXPO_PUBLIC_SHOPIFY_SYNC_API_URL=https://your-backend.example.com/api
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-restricted-google-places-api-key

# Google OAuth web client ID used by Supabase Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# GIG Logistics tracking endpoint. Tracking is simulated until this is real.
EXPO_PUBLIC_GIGL_TRACKING_API_URL=https://your-gigl-endpoint.example.com
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=suq49d-ve.myshopify.com
# Optional: Cart operations use Shopify's tokenless Storefront API.
# EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-access-token

# Shopify Customer Account API public mobile client (OAuth + PKCE).
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-public-customer-account-client-id
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=shop.your-numeric-shop-id.app://callback
